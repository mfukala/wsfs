{
  "name": "@mfukala/wsfs",
  "version": "0.1.8",
  "description": "wsfs: local-first virtual filesystem with IndexedDB cache and pluggable backend persistence.",
  "keywords": [
    "local-first",
    "offline-first",
    "virtual filesystem",
    "indexeddb",
    "offline sync",
    "file sync",
    "optimistic concurrency",
    "etag",
    "rest api",
    "browser storage",
    "service worker",
    "transactional",
    "filesystem abstraction"
  ],
  "homepage": "https://github.com/mfukala/wsfs",
  "bugs": {
    "url": "https://github.com/mfukala/wsfs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:mfukala/wsfs.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "clean:test": "rm -rf dist-test",
    "build": "npm run lint && npm run clean && tsc -p tsconfig.json",
    "dev:server": "ts-node --esm src/server/express/server.ts",
    "test:build": "npm run clean:test && tsc -p tsconfig.test.json",
    "test": "npm run test:build && mocha --timeout 10000 \"dist-test/test/**/*.test.js\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "dist": "npm run build && npm run test && npm pack"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^4.3.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "better-sqlite3": "^12.4.6",
    "chai": "^4.4.1",
    "eslint": "^9.39.1",
    "express": "^4.18.2",
    "globals": "^15.12.0",
    "mocha": "^10.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "node": ">=18"
  }
}
