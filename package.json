{
  "name": "@mfukala/wsfs",
  "version": "0.1.5",
  "description": "wsfs: local-first virtual filesystem with IndexedDB cache and pluggable backend persistence.",
  "homepage": "https://www.npmjs.com/package/@mfukala/wsfs",
  "bugs": {
    "url": "https://github.com/mfukala/wsfs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "clean:test": "rm -rf dist-test",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev:server": "ts-node --esm src/server/express/server.ts",
    "test:build": "npm run clean:test && tsc -p tsconfig.test.json",
    "test": "npm run test:build && mocha --timeout 10000 \"dist-test/test/**/*.test.js\"",
    "dist": "npm run build && npm run test && npm pack"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    }
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.6",
    "chai": "^4.4.1",
    "express": "^4.18.2",
    "mocha": "^10.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
